# Copy to .env for local development. docker-compose reads this file automatically.

# --- Postgres ---
# `afridock` (POSTGRES_USER) is a superuser — used only for migrations
# (MIGRATIONS_DATABASE_URL), since Postgres superusers always bypass row-level
# security. The running API connects as `afridock_app`, a non-superuser role
# that migration 0002 creates, so RLS tenant-isolation policies actually apply.
POSTGRES_USER=afridock
POSTGRES_PASSWORD=afridock
POSTGRES_DB=afridock
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
APP_DB_PASSWORD=afridock_app_local_dev
DATABASE_URL=postgresql+asyncpg://afridock_app:afridock_app_local_dev@postgres:5432/afridock
MIGRATIONS_DATABASE_URL=postgresql+asyncpg://afridock:afridock@postgres:5432/afridock

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- API ---
API_ENV=local
API_SECRET_KEY=change-me-in-every-environment
API_CORS_ORIGINS=http://localhost:5173
# Only needed if the frontend is served cross-site from the API (e.g. a dev
# tunnel). Requires the API itself to also be served over HTTPS — Secure
# cookies are dropped by the browser if the response that sets them isn't
# HTTPS, and SameSite=None cookies must be Secure. Leave unset otherwise.
# API_COOKIE_SAMESITE=none
# API_COOKIE_SECURE=true

# --- Frontend (Vite exposes only VITE_-prefixed vars to the browser) ---
VITE_API_BASE_URL=http://localhost:8000

# --- LLM providers (fill in per environment; leave blank for local stub mode) ---
HUGGINGFACE_API_TOKEN=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
