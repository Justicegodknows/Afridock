# Copy to .env for local development. docker-compose reads this file automatically.

# --- Postgres ---
POSTGRES_USER=afridock
POSTGRES_PASSWORD=afridock
POSTGRES_DB=afridock
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://afridock:afridock@postgres:5432/afridock

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- API ---
API_ENV=local
API_SECRET_KEY=change-me-in-every-environment
API_CORS_ORIGINS=http://localhost:5173

# --- Frontend (Vite exposes only VITE_-prefixed vars to the browser) ---
VITE_API_BASE_URL=http://localhost:8000

# --- LLM providers (fill in per environment; leave blank for local stub mode) ---
HUGGINGFACE_API_TOKEN=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
